# Variables de los test E2E (npm run test:e2e).
# Copiar como .env en la raíz. Las del entorno tienen prioridad sobre este archivo.
# La aplicación se configura aparte, en backend/.env y frontend/.env.

# GITLAB ENV VARIABLES
# El recorrido carga este PAT en «Mi cuenta», igual que lo haría una persona.
GITLAB_TOKEN=glpat-xxxxxxxxxxxx
E2E_GITLAB_BASE_URL=https://gitlab.com

# PROYECTOS DE TEST
# Nunca apuntar a los proyectos de trabajo real: el recorrido depende de datos estables.
E2E_PROJECT_IDS=123,456
E2E_PROJECT_PATH=grupo/proyecto
# Nickname de GitLab que el recorrido carga en «Mi cuenta».
E2E_GITLAB_USERNAME=usuario-de-gitlab

# BASE DE DATOS DE TEST
# Base de Neon dedicada a los E2E: el usuario del recorrido se borra y se
# recrea en cada corrida. Nunca apuntar a la base de trabajo.
E2E_DATABASE_URL=postgresql://usuario:contrasena@ep-algo-pooler.region.aws.neon.tech/e2e?sslmode=require

# MERGE REQUEST CONOCIDO
E2E_MR_TITLE=Título exacto de un merge request abierto
E2E_MR_COLUMN=Code Review
