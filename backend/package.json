{
  "name": "gitlab-mr-board-backend",
  "version": "1.0.0",
  "description": "BFF backend for GitLab MR Dashboard",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": "^22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "users": "node src/scripts/users.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  }
}
