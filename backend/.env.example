###############################################################################
##                              BASE DE DATOS                                ##
###############################################################################

# Cadena de conexión PostgreSQL de Neon.
DATABASE_URL = "postgresql://usuario:contrasena@ep-algo-pooler.region.aws.neon.tech/neondb?sslmode=require"

###############################################################################
##                                  EMAILS                                   ##
###############################################################################

# En desarrollo no se abre una conexión SMTP: el enlace queda en la terminal.
# En producción FRONTEND_BASE_URL, MAIL_FROM y SMTP_HOST son obligatorias.
# Remitente que aparece en los correos de restablecimiento de contraseña.
MAIL_FROM=GitLab MR Board <no-reply@example.com>

# Host del servidor SMTP que entrega los correos.
SMTP_HOST=smtp.example.com

# Puerto del servidor SMTP.
SMTP_PORT=587

# Usar TLS desde el inicio de la conexión; suele ser `true` con el puerto 465.
SMTP_SECURE=false

# Son opcionales para servidores sin autenticación, pero deben definirse juntos.
# Usuario con el que el backend se autentica ante el servidor SMTP.
SMTP_USER=

# Contraseña con la que el backend se autentica ante el servidor SMTP.
SMTP_PASSWORD=

###############################################################################
##                                  GITLAB                                   ##
###############################################################################

# URL base de la instancia de GitLab consultada por el tablero.
GITLAB_BASE_URL = "https://gitlab.com"

###############################################################################
##                                  SENTRY                                   ##
###############################################################################

# DSN del proyecto de Sentry. Sin valor, el reporte del backend queda deshabilitado.
SENTRY_DSN=

# Identificador inmutable del despliegue; debe coincidir con el del frontend.
# En Vercel, si queda vacío, se usa VERCEL_GIT_COMMIT_SHA cuando está disponible.
SENTRY_RELEASE=

###############################################################################
##                                  ENTORNO                                  ##
###############################################################################

# Ambiente de ejecución: `development` para desarrollo local, `test` para los
# test automatizados y `production` para despliegues. Sólo `production` habilita
# el envío de emails y exige cookies de sesión por HTTPS de forma predeterminada.
NODE_ENV = "development"

# Puerto HTTP en el que escucha el backend durante la ejecución local.
PORT = 3001

###############################################################################
##                        CONFIGURACIÓN DEL TABLERO                          ##
###############################################################################

# Tiempo, en milisegundos, durante el que se reutilizan las respuestas de GitLab.
POLL_CACHE_TTL_MS = 60000

# Username de GitLab cuya aprobación se considera la del líder del equipo.
TEAM_LEAD_USERNAME = "NGiudi"

# Cantidad mínima de aprobaciones que necesita un merge request.
MIN_APPROVALS = 2

###############################################################################
##                             AUTENTICACIÓN                                 ##
###############################################################################

# Exigir HTTPS en la cookie de sesión. Se activa solo con NODE_ENV=production.
COOKIE_SECURE=false

# URL pública del frontend usada en los enlaces de restablecimiento.
FRONTEND_BASE_URL=http://localhost:5173

# Cantidad de minutos durante los que sirve un enlace para restablecer la contraseña.
PASSWORD_RESET_DURATION_MINUTES = 30

# Cantidad de días durante los que una sesión permanece vigente.
SESSION_DURATION_DAYS = 7

###############################################################################
##                                CIFRADO                                    ##
###############################################################################

# Cifra los access token de GitLab guardados en la base. Mínimo 32 caracteres.
# Generar uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Cambiarla vuelve ilegibles los tokens ya guardados.
ENCRYPTION_KEY=cambiar-por-un-valor-aleatorio-de-32-caracteres
