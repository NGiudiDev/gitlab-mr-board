# GITLAB ENV VARIABLES
# Los IDs de los proyectos y el access token los carga cada persona desde
# «Mi cuenta»: se guardan en la base y el token queda cifrado.
GITLAB_BASE_URL=https://gitlab.com

# LOCAL ENV VARIABLES
PORT=3001

# APP SETTINGS
POLL_CACHE_TTL_MS=60000
TEAM_LEAD_USERNAME=NGiudi
MIN_APPROVALS=2

# DATABASE
# Cadena de conexión de Neon. Conviene la del pooler —la que trae `-pooler` en
# el host—: el backend abre su propio pool y las conexiones directas de
# Postgres son un recurso escaso.
DATABASE_URL=postgresql://usuario:contrasena@ep-algo-pooler.region.aws.neon.tech/neondb?sslmode=require

# AUTHENTICATION
SESSION_DURATION_DAYS=7
# Exigir HTTPS en la cookie de sesión. Se activa solo con NODE_ENV=production.
COOKIE_SECURE=false

# ENCRYPTION
# Cifra los access token de GitLab guardados en la base. Mínimo 32 caracteres.
# Generar uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Cambiarla vuelve ilegibles los tokens ya guardados.
ENCRYPTION_KEY=cambiar-por-un-valor-aleatorio-de-32-caracteres
