{
  "name": "gitlab-mr-board",
  "version": "1.0.0",
  "private": true,
  "description": "GitLab MR Board - Backend + Frontend",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors blue,green --kill-others-on-fail \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit",
    "test:unit": "npm run test --prefix backend && npm run test --prefix frontend",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.69.0",
    "concurrently": "^10.0.5",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "vitepress": "^1.6.4"
  }
}
